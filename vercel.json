{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "public": "dist/client",
  "builds": [
    {
      "src": "api/[[...slug]].js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/[[...slug]].js"
    }
  ]
}
